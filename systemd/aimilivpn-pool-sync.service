[Unit]
Description=Pull authoritative AimiliVPN pool snapshot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/aimilivpn
EnvironmentFile=-/etc/default/aimilivpn
ExecStart=/usr/bin/python3 /opt/aimilivpn/scripts/pull_pool_snapshot.py
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/aimilivpn
ReadWritePaths=/opt/aimilivpn/vpngate_data
