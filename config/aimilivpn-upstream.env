# AimiliVPN upstream consumer profile for Yuntu
STRICT_RESIDENTIAL_ONLY=true
TZ=Asia/Shanghai
POOL_SOURCE_MODE=upstream-consumer

# Keep the same hard-gate contract as the authority. Consumer mode trusts the
# upstream classification and owns only local single-connection throughput.
TRUSTED_POOL_LIMIT=10
OBSERVATION_POOL_LIMIT=10
TRUST_MIN_IP_SCORE=90
TRUST_MIN_SUCCESSES=1
HARD_GATE_TTL_SECONDS=108000
AUTO_FAVORITE_SCORE=100
STANDBY_TARGET=10
STANDBY_MAX_AGE_SECONDS=691200
STANDBY_SCAN_BATCH_SIZE=10
STANDBY_SCAN_LIMIT=20
TEST_MAX_WORKERS=1
DAILY_MAINTENANCE_START_HOUR=3
DAILY_MAINTENANCE_END_HOUR=4
EMERGENCY_REFILL_COOLDOWN_SECONDS=21600
STABLE_POOL_PROBE_DAILY_LIMIT=2
STABLE_POOL_PROBE_BYTES=25000000
STABLE_POOL_PROBE_UPLOAD_BYTES=3000000
STABLE_POOL_PROBE_SAMPLES=2
FULL_PROBE_BYTES=10000000
QUALITY_TIE_WINDOW=5
SPEED_SWITCH_GAIN_PERCENT=30
SWITCH_REQUIRED_WINS=2

UPSTREAM_SNAPSHOT_MAX_AGE_SECONDS=7200
UPSTREAM_SNAPSHOT_MAX_BYTES=8388608
UPSTREAM_SNAPSHOT_MAX_NODES=300
UPSTREAM_PROBE_COOLDOWN_SECONDS=1800
UPSTREAM_LOCAL_PROBE_BATCH_SIZE=10
UPSTREAM_LOCAL_PROBE_INTERVAL_SECONDS=300
UPSTREAM_LOCAL_PROBE_BYTES=25000000
UPSTREAM_LOCAL_PROBE_SAMPLES=1
UPSTREAM_LOCAL_PROBE_RETENTION_SECONDS=172800
UPSTREAM_SYNC_PORT=22
UPSTREAM_SYNC_USER=aimili-sync
UPSTREAM_SYNC_KEY=/etc/aimilivpn/sync_ed25519
UPSTREAM_SYNC_KNOWN_HOSTS=/etc/aimilivpn/known_hosts

LOCAL_PROXY_HOST=127.0.0.1
LOCAL_PROXY_PORT=7928
UI_HOST=127.0.0.1
UI_PORT=8787

# Dual-slot failover tuning (must match the runtime defaults in vpngate_manager.py)
DRAIN_SECONDS=60
SWITCH_COOLDOWN_SECONDS=600
NODE_FAILURE_COOLDOWN_SECONDS=21600
VPNGATE_PROBE_FAIL_THRESHOLD=2
STANDBY_SLOT_MAX_FAILURES=3
STANDBY_SLOT_PAUSE_SECONDS=600
